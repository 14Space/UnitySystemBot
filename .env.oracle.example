# Отличия .env для сервера Oracle (ARM, без видеокарты).
#
# НЕ копируй этот файл целиком! Возьми свой рабочий .env (со всеми токенами и
# ключами) и ЗАМЕНИ в нём три строки Whisper на значения ниже. Остальное — токены,
# ADMIN_ID, Spotify и т.д. — остаётся как есть.
#
# Почему так: на Oracle нет GPU, поэтому расшифровка идёт на процессоре (cpu).
# Модель large-v3 на CPU слишком тяжёлая — берём medium. Тип вычислений на CPU —
# int8 (быстро и без ошибок; float16 на процессоре не годится).

WHISPER_MODEL=medium       # было large-v3 — на CPU medium ощутимо шустрее
WHISPER_DEVICE=cpu         # было cuda — на Oracle видеокарты нет
WHISPER_COMPUTE_TYPE=int8  # для CPU; на GPU этой строки не было (там float16)

# Языки и прочие Whisper-настройки можно оставить прежними:
# WHISPER_LANGUAGES=ru,uk,en
# WHISPER_LANG_MIN_PROB=0.85
# WHISPER_PREWARM=true
